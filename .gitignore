# vscode
.vscode
.history/

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js
!releases/*/main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

yarn-error.log

# AI internal workspace — lives at workspace level, never inside plugin repo
.ai_internal/
memories/

# CRITICAL: Personal Data Protection
OBScync/
EMERGENCY-BACKUPS/
personal-*
*-vault/
!demo-vault/
# Allow the demo vault plugin data (stripped of personal paths)
!demo-vault/.obsidian/
!demo-vault/.obsidian/plugins/
!demo-vault/.obsidian/plugins/obs-projects-plus/
!demo-vault/.obsidian/plugins/obs-projects-plus/data.json
!demo-vault/.obsidian/community-plugins.json
*.personal

# Ephemeral dev/debug dumps (never commit)
_git_log.txt
failures.txt
ts_errors.txt
lint_output*.txt
/RELEASE_NOTES.md

# Recovery bundles
*.bundle

# AI agent configuration is NOT public (policy change 2026-08-25).
#
# This repository is public. Agent definitions, prompts, hooks and the project
# instruction files describe how the work is actually done and are not intended
# for outside review, so they live on the maintainer's machine and are excluded
# here. They were tracked before this date and remain in git history; this rule
# stops anything further being published, it does not retroactively unpublish.
.claude/
.codex/
CLAUDE.md
AGENTS.md

# The Copilot agent system was archived out of the repo entirely on 2026-08-25
# (see ../.ai_internal/archive/copilot-2026-08-25/). Guard against it returning.
.github/agents/
.github/instructions/
.github/prompts/
.github/hooks/
.github/COPILOT_SETUP.md

# Still tracked on purpose: docs/internal/ is engineering documentation —
# BACKLOG, CONTEXT, ADRs, design briefs — not agent configuration, and
# docs/internal/CONTEXT.md is the canonical baseline the test ratchet reads.

# .vscode/mcp.json contains personal absolute paths and env-var refs — local only.
# .vscode itself is already gitignored above; no extra rule needed here.

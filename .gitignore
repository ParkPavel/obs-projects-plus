# vscode
.vscode
.history/

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js
!releases/*/main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

yarn-error.log

# AI internal workspace — lives at workspace level, never inside plugin repo
.ai_internal/
memories/

# CRITICAL: Personal Data Protection
OBScync/
EMERGENCY-BACKUPS/
personal-*
*-vault/
!demo-vault/
# Allow the demo vault plugin data (stripped of personal paths)
!demo-vault/.obsidian/
!demo-vault/.obsidian/plugins/
!demo-vault/.obsidian/plugins/obs-projects-plus/
!demo-vault/.obsidian/plugins/obs-projects-plus/data.json
!demo-vault/.obsidian/community-plugins.json
*.personal

# Ephemeral dev/debug dumps (never commit)
_git_log.txt
failures.txt
ts_errors.txt
lint_output*.txt
/RELEASE_NOTES.md

# Recovery bundles
*.bundle

# Agent configuration moved to https://github.com/ParkPavel/claudex (2026-09-10).
# Keep accidental legacy copies and machine-local settings out of this product repo.
# Native entrypoints are generated at the workspace desktop level by Claudex.
.claude/
.codex/
.agents/
CLAUDE.md
AGENTS.md

# The Copilot agent system was archived out of the repo entirely on 2026-08-25
# (see ../.ai_internal/archive/copilot-2026-08-25/). Guard against it returning.
.github/agents/
.github/instructions/
.github/prompts/
.github/hooks/
.github/COPILOT_SETUP.md

# Still tracked on purpose: docs/internal/ is engineering documentation —
# BACKLOG, CONTEXT, ADRs, design briefs — not agent configuration, and
# docs/internal/CONTEXT.md is the canonical baseline the test ratchet reads.

# The legacy .vscode/mcp.json was retired into a private Claudex migration backup.
# Editor preferences remain local; .vscode is already ignored above.
